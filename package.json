{
  "name": "smarter-work-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3006",
    "dev:review": "vite --mode review --host 127.0.0.1 --port 3006",
    "build": "tsc --noEmit && vite build",
    "build:hosting": "tsx scripts/build-hosting.ts",
    "build:team-review": "tsc --noEmit && vite build --mode team-review",
    "preview": "vite preview --host 127.0.0.1 --port 3007",
    "preview:team-review": "vite preview --outDir dist-team-review --host 127.0.0.1 --port 3008",
    "test": "tsx --test tests/core.test.ts tests/review-build.test.ts tests/reminders.test.ts tests/welcome.test.ts tests/cloudflare.test.ts",
    "test:browser": "playwright test",
    "workbooks": "tsx scripts/workbooks.ts",
    "build:cloudflare:public": "tsx scripts/build-cloudflare.ts public",
    "build:cloudflare:review": "tsx scripts/build-cloudflare.ts review",
    "deploy:cloudflare:public": "wrangler deploy --config wrangler.public.jsonc",
    "deploy:cloudflare:review": "wrangler deploy --config wrangler.review.jsonc",
    "check:cloudflare:public": "wrangler deploy --config wrangler.public.jsonc --dry-run",
    "check:cloudflare:review": "wrangler deploy --config wrangler.review.jsonc --dry-run"
  },
  "dependencies": {
    "jspdf": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "4.157.0"
  }
}
