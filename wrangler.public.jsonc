{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smarter-work-2026",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build:cloudflare:public" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
